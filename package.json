{
  "name": "excruciate",
  "version": "0.1.0",
  "type": "module",
  "description": "A test runner for LLM agents against stateful simulated APIs.",
  "license": "MIT",
  "author": "Alex Martynov",
  "homepage": "https://github.com/amfenix/EXCRUCIATE#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amfenix/EXCRUCIATE.git"
  },
  "bugs": {
    "url": "https://github.com/amfenix/EXCRUCIATE/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "evaluation",
    "testing",
    "test-runner",
    "fault-injection",
    "anthropic",
    "sqlite"
  ],
  "bin": {
    "excruciate": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --max-diagnostics=500",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:write": "biome format --write",
    "test": "bun test test",
    "build": "bun run scripts/build.ts",
    "verify": "bun run lint && bun run typecheck && bun test test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@napi-rs/keyring": "1.3.0",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@combycode/llm-sdk": "2.0.1",
    "exceljs": "4.4.0"
  },
  "peerDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/keyring": {
      "optional": true
    }
  }
}
